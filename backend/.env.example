# Copy to backend/.env for local runs (never commit the real file).
APP_ENVIRONMENT=development
APP_SECRET_KEY=replace-with-output-of-python-c-import-secrets-print-secrets-token-urlsafe-48
APP_DATABASE_URL=sqlite:///./data/app.db
APP_MEDIA_DIR=./data/media
# URL the phone uses to reach the API (emulator: http://10.0.2.2:8000, device on LAN: http://<pc-ip>:8000)
APP_PUBLIC_BASE_URL=http://10.0.2.2:8000
APP_EMAIL_BACKEND=console
# APP_EMAIL_BACKEND=smtp
# APP_SMTP_HOST=localhost
# APP_SMTP_PORT=1025
# APP_REQUIRE_EMAIL_VERIFICATION=true

# Optional: enables the Claude-powered search assistant (otherwise fuzzy-search fallback).
# ANTHROPIC_API_KEY=
